// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sponsor {
  id          String   @id @default(uuid())
  companyName String
  industry    String
  deals       Deal[]
}

model Deal {
  id           String   @id @default(uuid())
  sponsorId    String
  creatorEmail String
  amount       Float
  sponsor      Sponsor  @relation(fields: [sponsorId], references: [id])
}
